# Set to http://localhost:6333 for Docker Qdrant, or a filesystem path for embedded Qdrant.
GLANCE_QDRANT_URL=http://localhost:6333
GLANCE_RECORDS_PATH=data/processed/corpus.jsonl
GLANCE_GENERIC_MODEL=openai/clip-vit-base-patch32
GLANCE_FASHION_MODEL=Marqo/marqo-fashionCLIP
# Optional locally trained adapter. Requires GLANCE_FASHION_MODEL to be a local snapshot.
# GLANCE_FASHION_ADAPTER=artifacts/fashionclip-lora
GLANCE_QUERY_MODEL=Qwen/Qwen2.5-1.5B-Instruct
GLANCE_DEVICE=auto
GLANCE_USE_QWEN_PARSER=false

# After downloading model snapshots into ``models/``, these local paths keep inference offline:
# GLANCE_GENERIC_MODEL=models/openai-clip-vit-base-patch32
# GLANCE_FASHION_MODEL=models/marqo-fashionCLIP
